<?xml version='1.0'?><!-- Game is either sse, tesv, or fo4 -->
<PapyrusProject xmlns="PapyrusProject.xsd"
    Flags="TESV_Papyrus_Flags.flg"
    Game="sse"
    Output="Data\Scripts"
    Optimize="false"
    Release="false"
    Final="false"
    Anonymize="true">
    <Imports>
        <Import>Data\Source\Scripts</Import>
        <Import>..\..\..\..\Bethesda\Data\SSE\mods\OG_SRC\Source\Scripts</Import>
    </Imports>
    <Folders>
        <Folder>.\Data\Source\Scripts</Folder>
    </Folders>
</PapyrusProject>
